syntax = "proto3";

package hello.world;

option go_package = "./;helloworld";
option php_namespace = "Google\\Cloud\\Iam\\V1";

service Greeter {
  rpc SayHello (.hello.world.HelloRequest) returns (.hello.world.HelloReply) {}
  rpc StreamMethodServer (.hello.world.StreamRequest) returns (stream .hello.world.StreamReply) {}
}

message Reserved {
  reserved "foo";
  reserved 1;
  reserved 4 to 7;
}

message ReservedEnum {
  reserved "FOO";
  reserved 10 to max;
}

message HelloRequest {
  message Test {
    string blah = 1 [json_name = "blah"];
  }

  enum NestedEnum {
    BLAH = 0;
  }

  string name = 1 [json_name = "name"];
  .hello.world.HelloRequest.Test blah = 2 [json_name = "blah"];
  .hello.world.HelloRequest.NestedEnum blahblah = 3 [json_name = "blahblah"];
  .hello.world.HelloReply blaha = 4 [json_name = "blaha"];
  optional string version = 5 [json_name = "version"];
}

message HelloReply {
  .hello.world.HelloRequest.Test blah = 2 [json_name = "blah"];
  .hello.world.HelloRequest.NestedEnum blahblah = 3 [json_name = "blahblah"];
  string message = 1 [json_name = "message"];
}

message StreamRequest {
  string message = 1 [json_name = "message"];
}

message StreamReply {
  string message = 1 [json_name = "message"];
}

